import numpy as np
from numba import njit, prange
import matplotlib.pyplot as plt

# ... keep your quat_mul, quat_conj as-is (they're fine)

@njit
def oct_mult(a, b):                     # unchanged
    p, q = a[:4], a[4:]
    r, s = b[:4], b[4:]
    pr = quat_mul(p, r)
    qs_conj = quat_mul(quat_conj(s), q)
    term1 = pr - qs_conj
    term2 = quat_mul(s, p) + quat_mul(q, quat_conj(r))
    return np.concatenate((term1, term2))

@njit
def associator_norm_squared(a, b, c):
    ab = oct_mult(a, b)
    abc = oct_mult(ab, c)
    bc = oct_mult(b, c)
    a_bc = oct_mult(a, bc)
    diff = abc - a_bc
    return np.dot(diff, diff)

@njit(parallel=True, fastmath=True)
def compute_gravity_map(grid):
    N = grid.shape[0]
    gravity = np.zeros((N, N))

    for i in prange(N):
        for j in range(N):
            A  = grid[i, j]
            Br = grid[(i + 1) % N, j]
            Cd = grid[i, (j + 1) % N]
            Bl = grid[(i - 1) % N, j]
            Cu = grid[i, (j - 1) % N]

            n1 = associator_norm_squared(A, Br, Cd)
            n2 = associator_norm_squared(A, Bl, Cu)
            gravity[i, j] = np.sqrt(0.5 * (n1 + n2))
    return gravity

